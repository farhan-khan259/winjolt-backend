NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/winjolt?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=2h
ADMIN_JWT_EXPIRES_IN=30m
FRONTEND_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
RESERVATION_TTL_MINUTES=10
PAYMENT_PROVIDER=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/order-confirmation?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/payment-status?cancelled=1
ADMIN_EMAIL=admin@winjolt.co.uk
ADMIN_PASSWORD=change-this-before-running-seed
TERMS_VERSION=prelaunch-v1
PRIVACY_VERSION=prelaunch-v1
GLOBAL_ENTRY_PAUSED=true
WALLET_REDEMPTION_ENABLED=false
FREE_ENTRY_ENABLED=false
SMTP_HOST=smtp.livemail.co.uk
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=welcome@winjoltcompetitions.co.uk
SMTP_PASSWORD=
EMAIL_FROM=WinJolt Competitions <welcome@winjoltcompetitions.co.uk>
